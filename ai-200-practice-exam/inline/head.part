<div id="ai200-exam-form">
  <div id="ai200-screen" aria-live="polite"></div>
</div>
<style>
#ai200-exam-form{color:var(--foreground);background:transparent;font-family:inherit}
#ai200-exam-form .exam-shell{display:grid;gap:1rem}
#ai200-exam-form .exam-head{display:flex;align-items:center;gap:1rem;flex-wrap:wrap;padding:.8rem 0;border-bottom:1px solid var(--border)}
#ai200-exam-form .exam-head h2{margin:0}
#ai200-exam-form .exam-spacer{flex:1}
#ai200-exam-form .exam-time{font-variant-numeric:tabular-nums;font-weight:500}
#ai200-exam-form .exam-layout{display:grid;grid-template-columns:minmax(0,1fr) 12rem;gap:1.25rem}
#ai200-exam-form .question-pane{min-width:0}
#ai200-exam-form .question-nav{border-left:1px solid var(--border);padding-left:1rem}
#ai200-exam-form .question-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:.35rem}
#ai200-exam-form .question-grid .btn{padding:.35rem;min-width:0}
#ai200-exam-form .choice-list{display:grid;gap:.6rem;margin:1rem 0}
#ai200-exam-form .choice-row{padding:.75rem;border-bottom:1px solid var(--border)}
#ai200-exam-form .choice-row:has(input:checked){background:var(--accent);color:var(--accent-foreground)}
#ai200-exam-form .case-tabs{margin:.75rem 0}
#ai200-exam-form .case-copy{padding:.8rem 0;border-bottom:1px solid var(--border)}
#ai200-exam-form .exam-actions{display:flex;align-items:center;gap:.5rem;flex-wrap:wrap;margin-top:1rem}
#ai200-exam-form .exam-actions .right{margin-left:auto}
#ai200-exam-form .order-row{display:grid;grid-template-columns:2rem 1fr auto;align-items:center;gap:.5rem;padding:.55rem 0;border-bottom:1px solid var(--border)}
#ai200-exam-form .result-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.75rem;margin:1rem 0}
#ai200-exam-form .answer-review{padding:.8rem 0;border-bottom:1px solid var(--border)}
#ai200-exam-form .correct{color:var(--green)}
#ai200-exam-form .incorrect{color:var(--red)}
#ai200-exam-form .text-wrap{overflow-wrap:anywhere}
@media(max-width:720px){#ai200-exam-form .exam-layout{grid-template-columns:1fr}#ai200-exam-form .question-nav{border-left:0;border-top:1px solid var(--border);padding:1rem 0 0}#ai200-exam-form .result-grid{grid-template-columns:1fr 1fr}}
@media(max-width:420px){#ai200-exam-form .result-grid{grid-template-columns:1fr}}
</style>
<script>
