
(()=>{
const DATA=window.AI200_DATA,screen=document.getElementById('ai200-screen');
let st=null,tick=null;
const shuffle=a=>{a=[...a];for(let i=a.length-1;i;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a};
const pick=(d,n)=>shuffle(DATA.QUESTION_BANK.filter(q=>q.domain===d)).slice(0,n);
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const fmt=s=>`${String(Math.floor(s/60)).padStart(2,'0')}:${String(s%60).padStart(2,'0')}`;
const eq=(a,b)=>Array.isArray(a)&&Array.isArray(b)?a.length===b.length&&a.every((v,i)=>v===b[i]):a===b;
function save(){if(!window.openai?.setWidgetState||!st)return;const answered=Object.keys(st.answers).length;window.openai.setWidgetState({modelContent:{mode:st.mode,current:st.i+1,total:st.qs.length,answered,finished:!!st.finished,score:st.score??null},privateContent:{answers:st.answers,flags:st.flags}}).catch(()=>{})}
function home(){clearInterval(tick);st=null;const total=DATA.QUESTION_BANK.length+DATA.CASES.reduce((n,c)=>n+c.questions.length,0)+DATA.LOCKED_SET.questions.length;screen.innerHTML=`<section class="exam-shell"><div><h2>AI-200 Exam Simulator</h2><p class="text-muted">English · ${total} verified practice questions · current AI-200 skills outline</p></div><div class="card"><strong>Official timing profile</strong><p>Microsoft role-based exam without a lab: 100 exam minutes, usually 40–60 questions. This simulator uses 50. The real introduction screen confirms case studies and possible labs.</p></div><div class="viz-grid"><div class="card"><h3>Full simulation</h3><p>50 questions · 100 minutes · case study · locked Yes/No set · no lab</p><button class="btn btn-primary btn-block" data-mode="exam">Start full simulation</button></div><div class="card"><h3>Case study drill</h3><p>5 questions · scenario tabs · no separate timer</p><button class="btn btn-block" data-mode="case">Start case study</button></div><div class="card"><h3>Quick assessment</h3><p>20 questions · 40 minutes · all four domains</p><button class="btn btn-block" data-mode="quick">Start quick assessment</button></div><div class="card"><h3>Study mode</h3><p>All ${total} questions · no timer · immediate explanations</p><button class="btn btn-block" data-mode="study">Start study mode</button></div></div><p class="text-small text-muted">The Microsoft exam can also use drag-and-drop, hot-area items, multiple case studies, and possibly a lab. Exact contents are shown when the exam starts.</p></section>`;screen.querySelectorAll('[data-mode]').forEach(b=>b.onclick=()=>start(b.dataset.mode))}
function start(mode){let qs,seconds=0;if(mode==='exam'){const c=DATA.CASES[Math.floor(Math.random()*DATA.CASES.length)];const cq=c.questions.map(q=>({...q,caseTitle:c.title,caseData:c.tabs}));const general=DATA.selectExamQuestions(c,shuffle);qs=Math.random()<.5?[...cq,...general]:[...general,...cq];qs.push(...DATA.LOCKED_SET.questions.map(q=>({...q,locked:true,lockedScenario:DATA.LOCKED_SET.scenario})));seconds=6000}else if(mode==='case'){const c=DATA.CASES[Math.floor(Math.random()*DATA.CASES.length)];qs=c.questions.map(q=>({...q,caseTitle:c.title,caseData:c.tabs}))}else if(mode==='quick'){qs=shuffle([...pick('containers',4),...pick('data',6),...pick('services',5),...pick('operations',5)]);seconds=2400}else{qs=shuffle([...DATA.QUESTION_BANK,...DATA.CASES.flatMap(c=>c.questions.map(q=>({...q,caseTitle:c.title,caseData:c.tabs}))),...DATA.LOCKED_SET.questions.map(q=>({...q,locked:false}))])}qs=qs.map(question=>DATA.prepareQuestion(question,shuffle));st={mode,qs,i:0,answers:{},flags:{},checked:{},lockedThrough:-1,seconds,tab:'Overview'};if(seconds)tick=setInterval(()=>{st.seconds--;const e=document.getElementById('ai200-clock');if(e)e.textContent=fmt(st.seconds);if(st.seconds<=0){clearInterval(tick);finish()}},1000);render();save()}
function q(){return st.qs[st.i]}
function answered(x=q()){const a=st.answers[x.id];return Array.isArray(a)?a.length>0:a!==undefined}
function correct(x=q()){const a=st.answers[x.id];return x.type==='multi'?eq([...(a||[])].sort(),[...x.answer].sort()):eq(a,x.answer)}
function render(){const x=q(),pct=Math.round((st.i+1)/st.qs.length*100);screen.innerHTML=`<section class="exam-shell"><header class="exam-head"><h2>AI-200</h2><span class="text-muted">Developing AI Cloud Solutions on Azure</span><span class="exam-spacer"></span>${st.seconds?`<span id="ai200-clock" class="exam-time">${fmt(st.seconds)}</span>`:'<span>Study mode</span>'}<strong>${st.i+1} / ${st.qs.length}</strong></header><div class="progress" role="progressbar" aria-label="Exam progress" aria-valuenow="${pct}" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar" style="width:${pct}%"></div></div><div class="exam-layout"><main class="question-pane"><p class="text-small text-muted">${esc(DATA.DOMAINS[x.domain])} · ${label(x)}</p>${caseBlock(x)}${x.lockedScenario?`<div class="card"><strong>Scenario</strong><p>${esc(x.lockedScenario)}</p></div>`:''}<h3>Question ${st.i+1}</h3><p>${esc(x.prompt)}</p><p class="text-small text-muted">${instruction(x)}</p>${answers(x)}${st.mode==='study'&&st.checked[x.id]?feedback(x):''}<div class="exam-actions"><label class="form-check"><input class="form-check-input" id="flagq" type="checkbox" ${st.flags[x.id]?'checked':''} ${x.locked?'disabled':''}><span class="form-check-label">Mark for review</span></label><span class="right"></span><button class="btn" id="prevq" ${st.i===0||st.i-1<=st.lockedThrough||x.locked?'disabled':''}>Previous</button>${st.mode==='study'?'<button class="btn" id="checkq">Check answer</button>':''}<button class="btn btn-primary" id="nextq">${st.i===st.qs.length-1?'Finish':'Next'}</button></div></main><aside class="question-nav"><p class="text-small text-muted">Questions</p><div class="question-grid">${st.qs.map((z,i)=>{const result=st.mode==='study'&&st.checked[z.id]?(correct(z)?'answer-correct':'answer-incorrect'):'';const resultLabel=result==='answer-correct'?', correct':result==='answer-incorrect'?', incorrect':'';return `<button class="btn ${i===st.i?'btn-primary':''} ${result}" data-go="${i}" ${i<=st.lockedThrough||z.locked&&i!==st.i?'disabled':''} aria-label="Question ${i+1}${resultLabel}${st.flags[z.id]?', marked for review':''}">${i+1}${st.flags[z.id]?'*':''}</button>`}).join('')}</div></aside></div></section>`;bind()}
function label(x){return x.type==='multi'?`Choose ${x.choose||x.answer.length}`:x.type==='order'?'Build list':x.type==='yesno'?'Yes / No':'Single choice'}
function instruction(x){if(x.type==='multi')return `Select ${x.choose||x.answer.length} answers.`;if(x.type==='order')return 'Arrange the steps in the correct order.';if(x.locked)return 'After Next, you cannot return to this question.';return 'Select the best answer.'}
function caseBlock(x){if(!x.caseData)return'';const tabs=Object.keys(x.caseData);if(!tabs.includes(st.tab))st.tab=tabs[0];return `<div><strong>Case study: ${esc(x.caseTitle)}</strong><div class="nav nav-pills case-tabs" role="tablist" aria-label="Case details">${tabs.map(t=>`<button class="nav-link ${t===st.tab?'active':''}" type="button" data-case-tab="${esc(t)}" aria-selected="${t===st.tab}">${esc(t)}</button>`).join('')}</div><div class="case-copy">${esc(x.caseData[st.tab])}</div></div>`}
function answers(x){if(x.type==='order'){let a=st.answers[x.id];if(!a){a=shuffle(x.options);st.answers[x.id]=a}return `<div>${a.map((v,i)=>`<div class="order-row"><strong>${i+1}</strong><span>${esc(v)}</span><span><button class="btn btn-ghost" data-up="${i}" ${i===0?'disabled':''}>Up</button><button class="btn btn-ghost" data-down="${i}" ${i===a.length-1?'disabled':''}>Down</button></span></div>`).join('')}</div>`}const a=st.answers[x.id];return `<div class="choice-list">${x.options.map((v,i)=>{const on=x.type==='multi'?(a||[]).includes(i):a===i;return `<label class="form-check choice-row"><input class="form-check-input" type="${x.type==='multi'?'checkbox':'radio'}" name="aianswer" value="${i}" ${on?'checked':''}><span class="form-check-label"><strong>${String.fromCharCode(65+i)}.</strong> ${esc(v)}</span></label>`}).join('')}</div>`}
function bind(){const x=q();screen.querySelectorAll('input[name=aianswer]').forEach(e=>e.onchange=()=>{const v=+e.value;if(x.type==='multi'){let a=[...(st.answers[x.id]||[])];st.answers[x.id]=e.checked?[...a,v]:a.filter(n=>n!==v)}else st.answers[x.id]=v;render();save()});screen.querySelectorAll('[data-up]').forEach(b=>b.onclick=()=>move(+b.dataset.up,-1));screen.querySelectorAll('[data-down]').forEach(b=>b.onclick=()=>move(+b.dataset.down,1));screen.querySelectorAll('[data-case-tab]').forEach(b=>b.onclick=()=>{st.tab=b.dataset.caseTab;render()});screen.querySelectorAll('[data-go]').forEach(b=>b.onclick=()=>{st.i=+b.dataset.go;render();save()});document.getElementById('flagq').onchange=e=>{st.flags[x.id]=e.checked;render();save()};document.getElementById('prevq').onclick=()=>{st.i--;render();save()};document.getElementById('nextq').onclick=()=>next();const c=document.getElementById('checkq');if(c)c.onclick=()=>{if(!answered())return;c.disabled=true;st.checked[x.id]=true;render();save()}}
function move(i,d){const x=q(),a=[...st.answers[x.id]],j=i+d;[a[i],a[j]]=[a[j],a[i]];st.answers[x.id]=a;render();save()}
function next(){const x=q();if(x.locked&&!answered()){showError('Select Yes or No before continuing.');return}if(st.mode==='study'&&answered(x))st.checked[x.id]=true;if(x.locked)st.lockedThrough=st.i;if(st.i===st.qs.length-1){finish();return}st.i++;st.tab='Overview';render();save()}
function showError(msg){let e=document.getElementById('ai200-error');if(!e){e=document.createElement('p');e.id='ai200-error';e.setAttribute('role','alert');e.className='text-destructive';document.querySelector('.exam-actions').before(e)}e.textContent=msg}
function answerText(x,a){if(a===undefined)return'No answer';if(x.type==='order')return a.join(' → ');if(Array.isArray(a))return a.map(i=>x.options[i]).join('; ');return x.options[a]}
function referenceMarkup(x){const link=(label,url)=>`<p><strong>${label}:</strong> <a target="_blank" rel="noopener" href="${esc(url)}">${esc(url)}</a></p>`;return (x.assessmentSource?link(x.adapted?"Microsoft Learn module (adapted)":"Microsoft Learn module",x.assessmentSource):"")+(x.practiceSource?link("Practice source",x.practiceSource):"")+link("Technical reference",x.source)}
function feedback(x){const ok=correct(x);return `<div class="card"><h3 class="${ok?'correct':'incorrect'}">${ok?'Correct':'Review this answer'}</h3><p><strong>Your answer:</strong> ${esc(answerText(x,st.answers[x.id]))}</p><p><strong>Correct answer:</strong> ${esc(answerText(x,x.answer))}</p><p>${esc(x.explanation)}</p>${referenceMarkup(x)}</div>`}
function finish(){clearInterval(tick);const total=st.qs.length,n=st.qs.filter(correct).length,score=Math.round(n/total*1000);st.finished=true;st.score=score;const domains=Object.keys(DATA.DOMAINS).map(d=>{const qs=st.qs.filter(x=>x.domain===d),c=qs.filter(correct).length;return{d,c,n:qs.length,p:qs.length?Math.round(c/qs.length*100):0}});screen.innerHTML=`<section class="exam-shell"><div><h2>${score>=700?'Pass':'Not passed'} · ${score}/1000</h2><p>${n} of ${total} questions correct. This is a practice estimate; Microsoft does not publish a simple raw-score conversion.</p></div><div class="result-grid">${domains.map(x=>`<div class="card"><p class="text-small text-muted">${esc(DATA.DOMAINS[x.d])}</p><div class="viz-stat-value">${x.p}%</div><p>${x.c}/${x.n}</p></div>`).join('')}</div><div><h3>Answer review</h3>${st.qs.map((x,i)=>`<details class="answer-review"><summary class="${correct(x)?'correct':'incorrect'}">Question ${i+1} · ${correct(x)?'Correct':'Incorrect'}</summary><p>${esc(x.prompt)}</p><p><strong>Your answer:</strong> ${esc(answerText(x,st.answers[x.id]))}</p><p><strong>Correct answer:</strong> ${esc(answerText(x,x.answer))}</p><p>${esc(x.explanation)}</p>${referenceMarkup(x)}</details>`).join('')}</div><button class="btn btn-primary" id="restart">Start another session</button></section>`;document.getElementById('restart').onclick=home;save()}
home();
})();
</script>
